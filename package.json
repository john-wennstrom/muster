{
  "name": "muster",
  "version": "0.1.0-beta.0",
  "private": true,
  "type": "module",
  "description": "A correctness-ready beta for OpenSpec-driven multi-agent development workflows in Pi.",
  "keywords": [
    "pi-package"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.0"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "files": [
    "extensions",
    "schemas",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "verify:import": "bun run extensions/fusion-harness/verify-import.ts",
    "test": "bun test extensions/fusion-harness/tests",
    "test:fusion-harness": "bun test extensions/fusion-harness/tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
